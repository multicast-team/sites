    "color",
    "prefix",
    "suffix"
   ],
   "properties": {
    "style": {
     "$ref": "common#/$defs/id"
    },
    "x": {
     "$ref": "common#/$defs/num"
    },
    "y": {
     "$ref": "common#/$defs/num"
    },
    "color": {
     "type": "string",
     "pattern": "^(#[0-9a-f]{6}|@[a-z][A-Za-z0-9.]*)$"
    },
    "prefix": {
