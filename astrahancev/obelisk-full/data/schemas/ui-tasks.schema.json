    "x",
    "y"
   ],
   "properties": {
    "style": {
     "$ref": "common#/$defs/id"
    },
    "x": {
     "$ref": "common#/$defs/num"
    },
    "y": {
     "$ref": "common#/$defs/num"
    }
   }
  },
  "final": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "color",
    "progressIsGoal"
   ],
   "properties": {
    "color": {
     "type": "string",
     "pattern": "^(#[0-9a-f]{6}|@[a-z][A-Za-z0-9.]*)$"
    },
    "progressIsGoal": {
     "type": "boolean"
    }
   }
  },
  "progress": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "style",
    "x",
    "y"
   ],
   "properties": {
    "style": {
     "$ref": "common#/$defs/id"
    },
    "x": {
     "$ref": "common#/$defs/num"
