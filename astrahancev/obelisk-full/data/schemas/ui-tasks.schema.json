      "properties": {
       "sprite": {
        "$ref": "common#/$defs/skinKey"
       },
       "x": {
        "$ref": "common#/$defs/num"
       },
       "y": {
        "$ref": "common#/$defs/num"
       },
       "sx": {
        "$ref": "common#/$defs/num"
       },
       "sy": {
        "$ref": "common#/$defs/num"
       }
      }
     }
    },
    "text": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "style",
      "x",
      "y",
      "key"
     ],
     "properties": {
      "style": {
       "$ref": "common#/$defs/id"
      },
      "x": {
       "$ref": "common#/$defs/num"
      },
      "y": {
       "$ref": "common#/$defs/num"
      },
      "key": {
       "$ref": "common#/$defs/stringKey"
      }
     }
    }
   }
