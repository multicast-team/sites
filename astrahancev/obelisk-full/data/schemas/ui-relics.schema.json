{
 "$id": "ui-relics",
 "title": "Меню реликвий, главная страница (data/ui/relics.json, этап 6.14)",
 "description": "Вёрстка меню реликвий из компонентов: заголовки разделов редкости, ряды реликвий (уровень/кап, бонус, подпись, серая плашка, требования), прокрутка и отсечение, ползунок, шапка (кнопки открытия, подпись последней реликвии, число сундуков). Поля шаблонов с id — привязки экрана (ui/screens/relics.mjs); y рядов — от якоря ряда. Тексты — части (t.* — ключ strings.json, {имя} — значение, прочее как есть). Координаты — px комнаты 500×960 и обязаны совпасть с O. Команд рисования нет.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "$schema",
  "screen",
  "version",
  "kitStyles",
  "disabledColor",
  "capColor",
  "list",
  "title",
  "rarities",
  "row",
  "overlay",
  "req",
  "reqTwo",
  "reqTexts",
  "levelTexts",
  "bonusPrefix",
  "relicTexts",
  "subTexts",
  "header",
  "thumb",
  "format",
  "summary",
  "touch",
  "chestKinds",
  "scroll"
 ],
 "$defs": {
  "leaf": {
   "type": "object",
   "required": [
    "component"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-zA-Z]+$"
    },
    "component": {
     "enum": [
      "sprite",
      "text",
      "rect"
     ]
    },
    "x": {
     "$ref": "common#/$defs/num"
    },
    "y": {
     "$ref": "common#/$defs/num"
    },
    "x1": {
     "$ref": "common#/$defs/num"
    },
    "y1": {
     "$ref": "common#/$defs/num"
    },
    "x2": {
     "$ref": "common#/$defs/num"
    },
    "y2": {
     "$ref": "common#/$defs/num"
    },
    "sprite": {
     "$ref": "common#/$defs/skinKey"
    },
    "frame": {
     "$ref": "common#/$defs/count"
    },
    "sx": {
     "$ref": "common#/$defs/num"
    },
    "sy": {
     "$ref": "common#/$defs/num"
    },
    "color": {
     "type": "string",
     "pattern": "^#[0-9a-f]{6}$"
    },
    "alpha": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "font": {
     "$ref": "common#/$defs/skinKey"
    },
    "text": {
     "$ref": "common#/$defs/stringKey"
    },
    "halign": {
     "enum": [
      "left",
      "center",
      "right"
     ]
    },
    "valign": {
     "enum": [
      "top",
      "middle",
      "bottom"
     ]
    },
    "snap": {
     "type": "boolean"
    },
    "xscale": {
     "$ref": "common#/$defs/num"
    },
    "yscale": {
     "$ref": "common#/$defs/num"
    }
   }
  }
 },
