{
 "$id": "ui-contracts",
 "title": "Меню контрактов (data/ui/contracts.json, этап 8.11)",
 "description": "Вёрстка меню контрактов из блоков: фон и шум, список 34 улучшений по мирам (шаг ряда, промежуток миров, граница рисования, заголовок мира, шаблон ряда от верха ряда, замок), шапка контракта (требование, руда, этаж, полоса баров, награда, Skip за самоцветы, Complete, Auto Complete), ползунок, верхняя полоса (номер контракта, очки, ☰), нижняя полоса Buy 1/5/10/Max, таблица значков и описаний улучшений. Координаты — px комнаты 500×960. Генерирует oracle/contracts811/mkdata811.py. Команд рисования нет.",
 "type": "object",
 "additionalProperties": false,
 "required": ["$schema", "screen", "version", "back", "noise", "list", "panel", "thumb", "topbar", "buybar", "upgrades"],
 "properties": {
  "$schema": {"const": "ui-contracts"},
  "screen": {"const": "contracts"},
  "version": {"$ref": "common#/$defs/version"},
  "comment": {"type": "string"},
  "back": {"type": "object"},
  "noise": {"type": "object", "additionalProperties": false, "required": ["sprite", "x", "step", "count", "sx", "sy", "alpha"],
   "properties": {"sprite": {"$ref": "common#/$defs/skinKey"}, "x": {"$ref": "common#/$defs/num"}, "step": {"$ref": "common#/$defs/num"}, "count": {"$ref": "common#/$defs/count"},
    "sx": {"$ref": "common#/$defs/num"}, "sy": {"$ref": "common#/$defs/num"}, "alpha": {"$ref": "common#/$defs/num"}}},
  "list": {"type": "object", "additionalProperties": false, "required": ["firstRow", "rowStep", "worldGap", "worlds", "cull", "section", "row", "lock"],
   "properties": {"firstRow": {"$ref": "common#/$defs/num"}, "rowStep": {"$ref": "common#/$defs/num"}, "worldGap": {"$ref": "common#/$defs/num"},
    "worlds": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "common#/$defs/int"}}},
    "cull": {"type": "object", "additionalProperties": false, "required": ["top", "bottom", "centerDy"],
     "properties": {"top": {"$ref": "common#/$defs/num"}, "bottom": {"$ref": "common#/$defs/num"}, "centerDy": {"$ref": "common#/$defs/num"}}},
    "section": {"type": "object"}, "row": {"type": "object"}, "lock": {"type": "object"}}},
  "panel": {"type": "object", "required": ["ores", "bar"], "properties": {"ores": {"type": "array", "maxItems": 86, "items": {"$ref": "common#/$defs/stringKey"}}, "bar": {"type": "object"}}},
  "thumb": {"type": "object", "additionalProperties": false, "required": ["x1", "x2", "top", "bottom", "view", "maxScroll", "color", "alpha"],
   "properties": {"x1": {"$ref": "common#/$defs/num"}, "x2": {"$ref": "common#/$defs/num"}, "top": {"$ref": "common#/$defs/num"}, "bottom": {"$ref": "common#/$defs/num"},
    "view": {"$ref": "common#/$defs/num"}, "maxScroll": {"$ref": "common#/$defs/num"}, "color": {"type": "string", "pattern": "^#[0-9a-f]{6}$"}, "alpha": {"$ref": "common#/$defs/num"}}},
  "topbar": {"type": "object"},
  "buybar": {"type": "object"},
  "upgrades": {"type": "object", "additionalProperties": false, "required": ["columns", "rows"],
   "properties": {"columns": {"const": ["id", "icon", "desc", "kind"]},
    "rows": {"type": "array", "minItems": 34, "maxItems": 34, "items": {"type": "array", "minItems": 4, "maxItems": 4,
     "prefixItems": [{"$ref": "common#/$defs/int"}, {"$ref": "common#/$defs/skinKey"}, {"$ref": "common#/$defs/stringKey"}, {"enum": ["+", "-", "x"]}]}}}}
 }
}
