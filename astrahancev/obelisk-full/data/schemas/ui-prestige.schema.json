       },
       {
        "type": "null"
       }
      ]
     },
     "plateSx": {
      "$ref": "common#/$defs/num"
     },
     "rows": {
      "type": "array",
      "minItems": 5,
      "maxItems": 10,
      "items": {
       "type": "object",
       "required": [
