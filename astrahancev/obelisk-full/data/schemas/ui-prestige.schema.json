   }
  },
  "rowPrice": {
   "type": "array",
   "minItems": 1,
   "maxItems": 4,
   "items": {
    "$ref": "#/$defs/leaf"
   }
  },
  "rowMaxed": {
   "type": "array",
   "minItems": 1,
