  },
  "disabledColor": {
   "type": "string",
   "pattern": "^#[0-9a-f]{6}$"
  },
  "dimColor": {
   "type": "string",
   "pattern": "^#[0-9a-f]{6}$"
  },
  "bg": {
   "type": "object",
   "required": [
    "fill",
    "noise"
   ],
   "additionalProperties": false,
   "properties": {
    "fill": {
     "$ref": "#/$defs/leaf"
    },
    "noise": {
     "$ref": "#/$defs/leaf"
    }
   }
  },
  "header": {
   "type": "array",
