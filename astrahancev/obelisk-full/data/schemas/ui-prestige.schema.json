    "confirm": {
     "$ref": "common#/$defs/stringKey"
    },
    "owned": {
     "type": "array",
     "minItems": 1,
     "maxItems": 12,
     "items": {
      "type": "string"
     }
    },
    "levels": {
     "type": "array",
     "minItems": 1,
     "maxItems": 12,
     "items": {
      "type": "string"
     }
    },
    "allOwnedButton": {
