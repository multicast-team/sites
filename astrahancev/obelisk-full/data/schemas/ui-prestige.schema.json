  },
  "tiers": {
   "type": "array",
   "minItems": 4,
   "maxItems": 4,
   "items": {
    "type": "object",
    "required": [
     "tier",
     "backing",
     "owned",
     "levels",
     "lock",
     "plateSx",
     "rows"
    ],
    "additionalProperties": false,
    "properties": {
     "tier": {
      "enum": [
       1,
       2,
       3,
       4
      ]
     },
     "backing": {
      "type": "object",
      "required": [
       "sprite"
      ],
      "additionalProperties": false,
      "properties": {
       "sprite": {
        "$ref": "common#/$defs/skinKey"
       },
       "frame": {
        "$ref": "common#/$defs/count"
       }
      }
     },
     "owned": {
      "$ref": "common#/$defs/stringKey"
     },
     "levels": {
