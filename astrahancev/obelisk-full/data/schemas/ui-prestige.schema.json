{
 "$id": "ui-prestige",
 "title": "Меню престижа и артефактов (data/ui/prestige.json, этап 6.24)",
 "description": "Вёрстка меню престижа из компонентов: шапка (очки за престиж, кнопка Prestige), блоки ярусов 1–4 (Summon, счётчики, замок), строки открытых артефактов (уровень/кап, эффект, цена или Maxed), плашка PP, ползунок, полоса подсказки. Поля шаблонов с id — привязки экрана (ui/screens/prestige.mjs). Тексты — части (t.* — ключ strings.json, {имя} — значение, прочее как есть). Координаты — px комнаты 500×960 при прокрутке 0 и обязаны совпасть с O. Команд рисования нет.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "$schema",
  "screen",
  "version",
  "disabledColor",
  "dimColor",
  "bg",
  "header",
  "headerTexts",
  "list",
  "block",
  "blockTexts",
  "lock",
  "row",
  "rowPrice",
  "rowMaxed",
  "rowTexts",
  "tiers",
  "badge",
  "thumb",
  "topBar"
 ],
 "$defs": {
  "leaf": {
   "type": "object",
   "required": [
    "component"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-zA-Z]+$"
    },
    "component": {
     "enum": [
      "sprite",
      "text",
      "rect"
     ]
    },
    "x": {
     "$ref": "common#/$defs/num"
    },
    "y": {
     "$ref": "common#/$defs/num"
    },
    "x1": {
     "$ref": "common#/$defs/num"
    },
    "y1": {
     "$ref": "common#/$defs/num"
    },
    "x2": {
     "$ref": "common#/$defs/num"
    },
    "y2": {
     "$ref": "common#/$defs/num"
    },
    "sx": {
     "$ref": "common#/$defs/num"
    },
    "sy": {
     "$ref": "common#/$defs/num"
    },
    "sep": {
     "$ref": "common#/$defs/num"
    },
    "width": {
     "$ref": "common#/$defs/num"
    },
    "sprite": {
     "$ref": "common#/$defs/skinKey"
    },
    "frame": {
     "$ref": "common#/$defs/count"
    },
    "color": {
     "type": "string",
     "pattern": "^#[0-9a-f]{6}$"
    },
    "alpha": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "font": {
     "$ref": "common#/$defs/skinKey"
    },
    "text": {
     "$ref": "common#/$defs/stringKey"
    },
    "halign": {
     "enum": [
      "left",
      "center",
      "right"
     ]
    },
    "valign": {
     "enum": [
      "top",
      "middle",
      "bottom"
     ]
    },
    "snap": {
     "type": "boolean"
    },
    "count": {
     "$ref": "common#/$defs/count"
    },
    "step": {
     "$ref": "common#/$defs/num"
    }
   }
  }
 },
 "properties": {
  "$schema": {
   "const": "ui-prestige"
  },
  "screen": {
   "const": "prestige"
  },
  "version": {
   "$ref": "common#/$defs/version"
  },
  "comment": {
