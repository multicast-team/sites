{
 "$id": "ui-upgrades",
 "title": "Экран Upgrades (data/ui/upgrades.json, этап 6.9)",
 "description": "Вёрстка экрана Upgrades из компонентов кита: список (шаги ряда, граница рисования), секции миров (цвет, подложка), смещения частей ряда от якоря (y значка строки), ползунок, полоса ☰, нижняя полоса с Buy All, значки строк, ключи текстов и свои стили поверх data/ui/kit.json. Координаты — px комнаты 500×960. Команд рисования нет.",
 "type": "object",
 "additionalProperties": false,
 "required": ["$schema", "screen", "version", "panel", "header", "list", "sections", "row", "scroll", "bar", "menu", "bottom", "texts", "styles", "icons"],
 "properties": {
  "$schema": {"const": "ui-upgrades"},
  "screen": {"const": "upgrades"},
  "version": {"$ref": "common#/$defs/version"},
  "room": {"type": "object", "additionalProperties": false, "required": ["w", "h"], "properties": {"w": {"const": 500}, "h": {"const": 960}}},
  "comment": {"type": "string"},
  "panel": {"type": "object", "required": ["style"], "properties": {"style": {"type": "string"}}},
  "header": {"type": "object", "required": ["style"], "properties": {"style": {"type": "string"}}},
  "list": {"type": "object", "additionalProperties": false, "required": ["rowCount", "x", "y", "headerToRow", "rowStep", "rowToHeader", "drawBelow"],
   "properties": {"rowCount": {"$ref": "common#/$defs/count"}, "x": {"$ref": "common#/$defs/num"}, "y": {"$ref": "common#/$defs/num"},
    "headerToRow": {"$ref": "common#/$defs/num"}, "rowStep": {"$ref": "common#/$defs/num"}, "rowToHeader": {"$ref": "common#/$defs/num"}, "drawBelow": {"$ref": "common#/$defs/num"}}},
  "sections": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["world", "color"],
   "properties": {"world": {"$ref": "common#/$defs/count"}, "color": {"type": "string", "pattern": "^#[0-9a-f]{6}$"}, "frame": {"type": "string"},
    "backing": {"$ref": "common#/$defs/skinKey"}, "badge": {"$ref": "common#/$defs/skinKey"}, "lockBacking": {"$ref": "common#/$defs/skinKey"}}}},
  "row": {"type": "object"},
  "scroll": {"type": "object", "required": ["style", "track"], "properties": {"style": {"type": "string"},
   "track": {"type": "object", "additionalProperties": false, "required": ["top", "bottom", "viewBottom", "maxScroll"],
    "properties": {"top": {"$ref": "common#/$defs/num"}, "bottom": {"$ref": "common#/$defs/num"}, "viewBottom": {"$ref": "common#/$defs/num"}, "maxScroll": {"$ref": "common#/$defs/num"}}},
    "drag": {"type": "object", "additionalProperties": false, "required": ["divisor", "repeatEvery"],
     "properties": {"divisor": {"$ref": "common#/$defs/num"}, "repeatEvery": {"$ref": "common#/$defs/count"}}}}},
  "bar": {"type": "object", "required": ["rects"], "properties": {"rects": {"type": "array", "maxItems": 8}}},
  "menu": {"type": "object"},
  "bottom": {"type": "object"},
  "texts": {"type": "object", "additionalProperties": {"$ref": "common#/$defs/stringKey"}},
  "styles": {"type": "object"},
  "icons": {"type": "array", "maxItems": 93, "items": {"type": "object", "additionalProperties": false, "required": ["row", "icon"],
   "properties": {"row": {"$ref": "common#/$defs/int"}, "icon": {"$ref": "common#/$defs/skinKey"}}}}
 }
}
