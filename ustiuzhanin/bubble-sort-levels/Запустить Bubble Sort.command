#!/bin/bash
# Bubble Sort local API companion. Contains code only, no credentials.
set -eu
cd "$(dirname "$0")"
if ! command -v python3 >/dev/null 2>&1; then
  echo "Для запуска нужен Python 3.10 или новее: https://www.python.org/downloads/macos/"
  read -r -p "Нажмите Enter, чтобы закрыть окно…" ignored
  exit 1
fi
export BUBBLE_SORT_LAUNCHER="$PWD/$(basename "$0")"
python3 - <<'BUBBLE_BOOTSTRAP'
import base64, os, sys, pathlib, subprocess, urllib.request, json, webbrowser, shutil
if sys.version_info < (3,10):
    raise SystemExit("Нужен Python 3.10 или новее: https://www.python.org/downloads/macos/")
root = pathlib.Path.home() / ".bubble-sort-api"
root.mkdir(mode=0o700, exist_ok=True)
source = pathlib.Path(os.environ["BUBBLE_SORT_LAUNCHER"]).read_text()
payload = source.split("\n__BUBBLE_PAYLOAD__\n",1)[1].strip()
package = root / "bubble-sort-api.pyz"
package.write_bytes(base64.b64decode(payload))
# Preserve the adjacent project configuration, without including it in this file.
for candidate in (pathlib.Path.cwd()/"level-dashboard/.env", pathlib.Path.cwd()/".env"):
    if candidate.exists() and not (root/".env").exists():
        fd=os.open(root/".env",os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
        with os.fdopen(fd,"wb") as target:
            target.write(candidate.read_bytes())
        break
try:
    with urllib.request.urlopen("http://127.0.0.1:8765/api/status",timeout=2) as response:
        status=json.load(response)
    if isinstance(status,dict) and "cached_range" in status:
        webbrowser.open("http://127.0.0.1:8765/")
        print("Модуль уже запущен. Отчёт открыт в браузере.")
        sys.exit(0)
except (OSError,ValueError):
    pass
# The child has a real terminal for private getpass input; this process keeps the window open.
result=subprocess.run([sys.executable,str(package)])
sys.exit(result.returncode)
BUBBLE_BOOTSTRAP
exit 0
__BUBBLE_PAYLOAD__

